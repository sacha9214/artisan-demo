---
import { site, url } from '../../lib/site';
import { isDemo } from '../../lib/cms';

// Pinned version + Subresource Integrity: the browser refuses the script if the CDN copy changes.
const DECAP = 'https://unpkg.com/decap-cms@3.17.3/dist/decap-cms.js';
const DECAP_SRI = 'sha384-RWRzuHfiZSWCt3nEvG7B0v3cMgM1C2UuJmgBSL92GQh4uXmNSkbcthql/mNBqvjr';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Gestion du site · {site.name}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {isDemo && <script is:inline src={url('/admin/demo-content.js')}></script>}
  </head>
  <body>
    {isDemo && (
      <div id="demo-note" style="position:fixed;left:12px;bottom:12px;z-index:9999;max-width:320px;background:#1e2a2e;color:#fff;font:14px/1.45 system-ui,sans-serif;padding:10px 14px;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.25)">
        <strong>Mode démo.</strong> Cliquez sur « Se connecter » puis modifiez ce que vous voulez : rien n'est enregistré, tout revient à zéro en rechargeant la page.
        <button type="button" onclick="this.parentElement.remove()" aria-label="Fermer" style="margin-left:6px;background:none;border:0;color:#ffd2bd;cursor:pointer;font:inherit">✕</button>
      </div>
    )}
    <script is:inline src={DECAP} integrity={DECAP_SRI} crossorigin="anonymous"></script>
    <script is:inline define:vars={{ preview: url('/admin/preview.css') }}>
      window.CMS && window.CMS.registerPreviewStyle(preview);
    </script>
  </body>
</html>
